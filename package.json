{
	"name": "agent-profiles",
	"version": "0.1.0",
	"description": "Repository-local instruction routing for coding agents",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/guisam/Agent-Profiles.git"
	},
	"homepage": "https://github.com/guisam/Agent-Profiles#readme",
	"bugs": "https://github.com/guisam/Agent-Profiles/issues",
	"keywords": [
		"agents",
		"instructions",
		"profiles",
		"claude",
		"codex"
	],
	"type": "module",
	"bin": {
		"agent-profiles": "dist/bin/agent-profiles.js"
	},
	"files": [
		"dist/",
		".agent-profiles/",
		"docs/",
		"examples/presets/",
		"CHANGELOG.md",
		"CONTRIBUTING.md"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"typecheck": "tsc && tsc -p tsconfig.strict.json",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check --write",
		"build": "node scripts/build.js",
		"prepack": "npm run build",
		"test": "node --test",
		"test:package": "npm run build && node scripts/package-smoke.js",
		"resolve": "node bin/agent-profiles.js resolve --json"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/node": "^24.19.2",
		"typescript": "7.0.2"
	}
}
